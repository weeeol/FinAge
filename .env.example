# FinAge Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/finage.db

# OpenAI API (Optional for deterministic MVP features, required for AI Q&A)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Base URL (for CORS)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
